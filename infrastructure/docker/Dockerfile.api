FROM golang:1.22-alpine AS builder

WORKDIR /app
COPY services/api/ .
RUN go mod download
RUN CGO_ENABLED=0 GOOS=linux go build -o controlhub-api ./cmd/server/

FROM alpine:latest
RUN apk --no-cache add ca-certificates tzdata
WORKDIR /root/

COPY --from=builder /app/controlhub-api .

EXPOSE 8080

ENV PORT=8080
ENV ENVIRONMENT=production

CMD ["./controlhub-api"]
