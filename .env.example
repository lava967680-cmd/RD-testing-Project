# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to git.

ENVIRONMENT=production

# Postgres
POSTGRES_USER=controlhub
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_RANDOM_PASSWORD
POSTGRES_DB=controlhub_db

# Full connection string used by the API service (must match the above)
DATABASE_URL=postgres://controlhub:CHANGE_ME_GENERATE_A_STRONG_RANDOM_PASSWORD@postgres:5432/controlhub_db?sslmode=disable

# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_AT_LEAST_32_BYTES

REDIS_URL=redis://redis:6379/0

# Your real production frontend domain, no trailing slash
CORS_ALLOWED_ORIGINS=https://your-production-domain.com
